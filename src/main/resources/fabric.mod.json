{
    "schemaVersion": 1,
    "id": "moody-shower",
    "version": "${version}",
    "name": "Moody Shower",
    "description": "Just a client-side gameplay enhancing mod.",
    "authors": [
        "MeteorOfTime",
        "Falling_Sakura"
    ],
    "contact": {
        "homepage": "https://github.com/MShower/MoodyShower",
        "sources": "https://github.com/MShower/MoodyShower"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.wiki": "https://github.com/MShower/MoodyShower/wiki",
                "modmenu.modrinth": "https://modrinth.com/project/moodyshower",
                "modmenu.issues": "https://github.com/MShower/MoodyShower/issues"
            },
            "update_checker": true
        }
    },
    "license": "MIT",
    "icon": "assets/moody-shower/icon.png",
    "environment": "client",
    "entrypoints": {
        "main": [
            "mshower.moody.MoodyShower"
        ],
        "client": [
            "mshower.moody.MoodyShowerClient"
        ],
        "fabric-datagen": [
            "mshower.moody.MoodyShowerDataGenerator"
        ],
        "modmenu": [
            "mshower.moody.config.ModMenuApiImpl"
        ]
    },
    "mixins": [
        "moody-shower.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.18.4",
        "minecraft": "~1.20.1",
        "java": ">=17",
        "fabric-api": "*"
    }
}